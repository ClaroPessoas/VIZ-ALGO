[], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 29, "comparisons": 0, "swaps": 0}, "message": "processed 12 accesses"}], "metrics": {"comparisons": 0, "swaps": 0, "steps": 29, "elapsed_ms": 0.174, "n": 6}, "source": "class LRUCache:\n    def __init__(self, capacity):\n        self.capacity = capacity\n        self.order = []\n\n    def get(self, key):\n        if key not in self.order:\n            return -1\n        self.order.remove(key)\n        self.order.insert(0, key)\n        return key\n\n    def put(self, key):\n        if key in self.order:\n            self.order.remove(key)\n        elif len(self.order) >= self.capacity:\n            self.order.pop()\n        self.order.insert(0, key)\n", "source_language": "python"}