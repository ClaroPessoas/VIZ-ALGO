 "message": "LCS length = 3"}], "metrics": {"comparisons": 0, "swaps": 0, "steps": 50, "elapsed_ms": 0.206, "n": 15}, "source": "def lcs(a, b):\n    m, n = len(a), len(b)\n    dp = [[0] * (n + 1) for _ in range(m + 1)]\n    for i in range(1, m + 1):\n        for j in range(1, n + 1):\n            if a[i - 1] == b[j - 1]:\n                dp[i][j] = dp[i - 1][j - 1] + 1\n            else:\n                dp[i][j] = max(dp[i - 1][j], dp[i][j - 1])\n    return dp[m][n]\n", "source_language": "python"}