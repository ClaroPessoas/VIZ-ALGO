t_counter": {"step": 16, "comparisons": 8, "swaps": 0}, "message": "find(0)=10, find(11)=10"}, {"frame": 16, "event_type": "mark", "line": 13, "indices": [0, 11], "structure_state": {"array": [10, 0, 2, 2, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [0, 11], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 17, "comparisons": 8, "swaps": 0}, "message": "skip union(0,11) — same component"}, {"frame": 17, "event_type": "compare", "line": 6, "indices": [4, 3], "structure_state": {"array": [10, 0, 2, 2, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [4, 3], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 18, "comparisons": 9, "swaps": 0}, "message": "find(4)=4, find(3)=2"}, {"frame": 18, "event_type": "assign", "line": 16, "indices": [3], "structure_state": {"array": [10, 0, 4, 2, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [3], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 19, "comparisons": 9, "swaps": 0}, "message": "union(4,3) linked components"}, {"frame": 19, "event_type": "compare", "line": 6, "indices": [3, 2], "structure_state": {"array": [10, 0, 4, 4, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [3, 2], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 20, "comparisons": 10, "swaps": 0}, "message": "find(3)=4, find(2)=4"}, {"frame": 20, "event_type": "mark", "line": 13, "indices": [3, 2], "structure_state": {"array": [10, 0, 4, 4, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [3, 2], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 21, "comparisons": 10, "swaps": 0}, "message": "skip union(3,2) — same component"}, {"frame": 21, "event_type": "done", "line": 24, "indices": [], "structure_state": {"array": [10, 0, 4, 4, 4, 4, 6, 6, 8, 8, 10, 10], "imag": [], "graph": null, "highlight": [], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 22, "comparisons": 10, "swaps": 0}, "message": "disjoint-set forest built"}], "metrics": {"comparisons": 10, "swaps": 0, "steps": 22, "elapsed_ms": 0.112, "n": 12}, "source": "def union_find(n):\n    parent = list(range(n))\n    rank = [0] * n\n\n    def find(x):\n        while parent[x] != x:\n            parent[x] = parent[parent[x]]\n            x = parent[x]\n        return x\n\n    def union(a, b):\n        ra, rb = find(a), find(b)\n        if ra == rb:\n            return False\n        if rank[ra] < rank[rb]:\n            parent[ra] = rb\n        elif rank[ra] > rank[rb]:\n            parent[rb] = ra\n        else:\n            parent[rb] = ra\n            rank[ra] += 1\n        return True\n\n    return parent, union\n", "source_language": "python"}