ull, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 19, "comparisons": 16, "swaps": 0}, "message": "traversal complete"}], "metrics": {"comparisons": 16, "swaps": 0, "steps": 19, "elapsed_ms": 0.157, "n": 12}, "source": "def astar(graph, start, goal):\n    g = {start: 0}\n    pq = [(heuristic(start, goal), 0, start)]\n    while pq:\n        f, cost, node = heappop(pq)\n        if node == goal:\n            return cost\n        for nxt, w in graph[node]:\n            ng = cost + w\n            if ng < g.get(nxt, inf):\n                g[nxt] = ng\n                heappush(pq, (ng + heuristic(nxt, goal), ng, nxt))\n    return None\n", "source_language": "python"}