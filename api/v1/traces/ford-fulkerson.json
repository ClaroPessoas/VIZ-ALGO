1], [2, 11, 13], [3, 4, 8], [4, 5, 7], [5, 6, 7], [6, 11, 13]], "directed": true, "visited": [], "active": [6], "active_edge": [], "frontier": [], "distances": [null, null, null, null, null, null, null, null, null, null, null, null], "start": 0, "target": 7, "layout": "ring", "positions": []}, "highlight": [], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 24, "comparisons": 7, "swaps": 0}, "message": "dequeue 6"}, {"frame": 24, "event_type": "done", "line": 42, "indices": [], "structure_state": {"array": [], "imag": [], "graph": {"node_count": 12, "edges": [[0, 1, 15], [0, 2, 8], [1, 2, 6], [2, 3, 11], [2, 11, 13], [3, 4, 8], [4, 5, 7], [5, 6, 7], [6, 11, 13]], "directed": true, "visited": [], "active": [], "active_edge": [], "frontier": [], "distances": [null, null, null, null, null, null, null, null, null, null, null, null], "start": 0, "target": 7, "layout": "ring", "positions": []}, "highlight": [], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 25, "comparisons": 7, "swaps": 0}, "message": "max flow = 0"}], "metrics": {"comparisons": 7, "swaps": 0, "steps": 25, "elapsed_ms": 0.174, "n": 12}, "source": "def ford_fulkerson(capacity, source, sink):\n    flow = {edge: 0 for edge in capacity}\n    total = 0\n\n    def bfs():\n        parent = {source: source}\n        queue = [source]\n        while queue:\n            u = queue.pop(0)\n            for v in capacity:\n                if v[0] == u and capacity[v] - flow.get(v, 0) > 0 and v[1] not in parent:\n                    parent[v[1]] = u\n                    queue.append(v[1])\n            for v in capacity:\n                if v[1] == u and flow.get((v[1], v[0]), 0) > 0 and v[0] not in parent:\n                    parent[v[0]] = u\n                    queue.append(v[0])\n        return parent if sink in parent else None\n\n    while True:\n        parent = bfs()\n        if not parent:\n            break\n        v = sink\n        bottleneck = float(\"inf\")\n        while v != source:\n            u = parent[v]\n            if (u, v) in capacity:\n                bottleneck = min(bottleneck, capacity[(u, v)] - flow[(u, v)])\n            else:\n                bottleneck = min(bottleneck, flow[(v, u)])\n            v = u\n        v = sink\n        while v != source:\n            u = parent[v]\n            if (u, v) in capacity:\n                flow[(u, v)] += bottleneck\n            else:\n                flow[(v, u)] -= bottleneck\n            v = u\n        total += bottleneck\n    return total\n", "source_language": "python"}