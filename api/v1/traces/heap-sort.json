ot, end):\n    while True:\n        child = root * 2 + 1\n        if child > end:\n            break\n        swap_idx = root\n        if arr[child] > arr[swap_idx]:\n            swap_idx = child\n        if child + 1 <= end and arr[child + 1] > arr[swap_idx]:\n            swap_idx = child + 1\n        if swap_idx == root:\n            break\n        arr[root], arr[swap_idx] = arr[swap_idx], arr[root]\n        root = swap_idx\n\n\ndef heap_sort(arr):\n    n = len(arr)\n    for i in range(n // 2 - 1, -1, -1):\n        sift_down(arr, i, n - 1)\n    for end in range(n - 1, 0, -1):\n        arr[0], arr[end] = arr[end], arr[0]\n        sift_down(arr, 0, end - 1)\n", "source_language": "python"}