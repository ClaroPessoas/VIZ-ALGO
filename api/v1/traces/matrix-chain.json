 "cost_counter": {"step": 20, "comparisons": 0, "swaps": 0}, "message": "min scalar multiplications = 152"}], "metrics": {"comparisons": 0, "swaps": 0, "steps": 20, "elapsed_ms": 0.1, "n": 7}, "source": "def matrix_chain(p):\n    n = len(p) - 1\n    m = [[0] * (n + 1) for _ in range(n + 1)]\n    for length in range(2, n + 1):\n        for i in range(1, n - length + 2):\n            j = i + length - 1\n            m[i][j] = float(\"inf\")\n            for k in range(i, j):\n                cost = m[i][k] + m[k + 1][j] + p[i - 1] * p[k] * p[j]\n                if cost < m[i][j]:\n                    m[i][j] = cost\n    return m[1][n]\n", "source_language": "python"}