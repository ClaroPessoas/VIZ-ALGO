"frame": 13, "event_type": "done", "line": 8, "indices": [], "structure_state": {"array": [], "imag": [], "graph": {"node_count": 12, "edges": [[0, 1, 2], [0, 8, 4], [1, 2, 1], [2, 3, 5], [3, 4, 4], [4, 5, 4], [5, 6, 3], [6, 7, 2], [7, 8, 9], [8, 9, 2], [8, 11, 7], [9, 10, 7], [10, 11, 1]], "directed": false, "visited": [], "active": [], "active_edge": [], "frontier": [], "distances": [0.0, 2.0, 3.0, 8.0, 12.0, 16.0, 19.0, 21.0, 4.0, 6.0, 13.0, 11.0], "start": 0, "target": 7, "layout": "ring", "positions": []}, "highlight": [], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 14, "comparisons": 11, "swaps": 0}, "message": "traversal complete"}], "metrics": {"comparisons": 11, "swaps": 0, "steps": 14, "elapsed_ms": 0.103, "n": 12}, "source": "def bellman_ford(edges, start):\n    dist = {n: float('inf') for n in nodes}\n    dist[start] = 0\n    for _ in range(len(nodes) - 1):\n        for u, v, w in edges:\n            if dist[u] + w < dist[v]:\n                dist[v] = dist[u] + w\n    return dist\n", "source_language": "python"}