[0, 1, 2], [0, 8, 4], [1, 2, 1], [2, 3, 5], [3, 4, 4], [4, 5, 4], [5, 6, 3], [6, 7, 2], [7, 8, 9], [8, 9, 2], [8, 11, 7], [9, 10, 7], [10, 11, 1]], "directed": false, "visited": [0, 1, 2, 8, 9, 3, 11, 4, 10, 7], "active": [], "active_edge": [], "frontier": [], "distances": [0.0, 2.0, 3.0, 8.0, 12.0, 16.0, Infinity, 13.0, 4.0, 6.0, 12.0, 11.0], "start": 0, "target": 7, "layout": "ring", "positions": []}, "highlight": [], "sorted_until": 0, "low": null, "high": null, "mid": null, "target": null}, "cost_counter": {"step": 24, "comparisons": 21, "swaps": 0}, "message": "traversal complete"}], "metrics": {"comparisons": 21, "swaps": 0, "steps": 24, "elapsed_ms": 0.17, "n": 12}, "source": "def dijkstra(graph, start, target):\n    dist = {n: float('inf') for n in graph}\n    dist[start] = 0\n    pq = [(0, start)]\n    while pq:\n        d, u = heappop(pq)\n        if u == target:\n            break\n        for v, w in graph[u]:\n            if d + w < dist[v]:\n                dist[v] = d + w\n                heappush(pq, (dist[v], v))\n    return dist\n", "source_language": "python"}